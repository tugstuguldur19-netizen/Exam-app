# SQLite by default for zero-config local/dev running. Point to Postgres in prod
# (postgresql://user:pass@host:5432/db) — Prisma provider is "sqlite" below; change
# prisma/schema.prisma datasource provider to "postgresql" when you switch.
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-dev-secret"

PORT=4000

# Optional. If set, the docx exam parser falls back to Claude to extract
# questions/answers from exam files that don't match the plain-text heuristics
# (e.g. inconsistent numbering, prose-style questions, no clear answer key).
# Without it, only the regex-based parser runs.
ANTHROPIC_API_KEY=""
