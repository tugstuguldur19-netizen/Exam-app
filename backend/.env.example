# PostgreSQL connection string. For local development:
#   createuser/createdb as in README, then
DATABASE_URL="postgresql://examprep:examprep@localhost:5432/examprep_dev"

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-dev-secret"

PORT=4000

# Optional. If set, uploaded .docx tests the built-in parser can't read (or
# can't find answers in) are sent to Claude to extract questions/answers, and
# short answers that don't match the key literally get a semantic check.
ANTHROPIC_API_KEY=""
