datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  uploads       Upload[]
  sessions      TestSession[]
}

// Curated content (subjects, lessons, bank questions) uses fixed ids set by
// the seed script, so reseeding never changes an id a client may hold.
model Subject {
  id          String @id
  slug        String @unique
  name        String
  description String
  sortOrder   Int    @default(0)

  lessons       Lesson[]
  plans         SubscriptionPlan[]
  subscriptions Subscription[]
  sessions      TestSession[]
}

model Lesson {
  id          String  @id
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int     @default(0)

  questions Question[]
  sessions  TestSession[]

  @@index([subjectId])
}

model SubscriptionPlan {
  id           String  @id
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  durationDays Int
  // Whole currency units (MNT has no minor unit in everyday pricing).
  price        Int
  currency     String  @default("MNT")

  subscriptions Subscription[]
}

// Time-boxed access to one subject's paid tests (lesson, mixed, mistakes).
// Any active subscription also lifts the free weekly upload limit.
model Subscription {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  startAt   DateTime         @default(now())
  endAt     DateTime
  createdAt DateTime         @default(now())

  @@index([userId, subjectId])
}

// A .docx test a user uploaded — private to them, independent of subjects.
model Upload {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  sourceFileName String
  parseWarnings  String[]
  extractionMode String
  createdAt      DateTime @default(now())
  // Soft delete: deleted uploads disappear from the list but still count
  // toward the free weekly upload limit.
  deletedAt      DateTime?

  questions Question[]
  sessions  TestSession[]

  @@index([userId, createdAt])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

// Exactly one of lessonId (curated bank) / uploadId (user upload) is set.
model Question {
  id          String       @id @default(cuid())
  lessonId    String?
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadId    String?
  upload      Upload?      @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  order       Int          @default(0)
  type        QuestionType
  prompt      String
  // SHORT_ANSWER only: the accepted answer (normalized exact match, then
  // optional semantic check).
  correctText String?
  explanation String?
  // Included in the subject's free trial test.
  isTrial     Boolean      @default(false)
  points      Int          @default(1)

  choices Choice[]
  answers Answer[]

  @@index([lessonId])
  @@index([uploadId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  label      String
  text       String
  isCorrect  Boolean  @default(false)

  answers Answer[]

  @@index([questionId])
}

enum TestMode {
  TRIAL
  LESSON
  MIXED
  MISTAKES
  UPLOAD
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
}

// One generated test instance. questionIds fixes which questions (and in
// what order) this session contains, since lesson/mixed/mistakes tests are
// randomly drawn at creation time.
model TestSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        TestMode
  title       String
  subjectId   String?
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadId    String?
  upload      Upload?       @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  questionIds String[]
  status      SessionStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  durationSec Int?
  scorePoints Int?
  totalPoints Int?

  answers Answer[]

  @@index([userId, submittedAt])
}

model Answer {
  id            String      @id @default(cuid())
  sessionId     String
  session       TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceId      String?
  choice        Choice?     @relation(fields: [choiceId], references: [id], onDelete: SetNull)
  answerText    String?
  isCorrect     Boolean?
  pointsAwarded Int         @default(0)

  @@unique([sessionId, questionId])
  @@index([questionId])
}
